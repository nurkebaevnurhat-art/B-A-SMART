# ─── Обязательные ───────────────────────────────────────────────
# Строка подключения к PostgreSQL. Для Neon/Supabase добавьте ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/basmart?schema=public"
# Публичный адрес сайта без слэша в конце (используется в ссылках, sitemap, платежах)
APP_URL="https://your-domain.kz"
# Длинная случайная строка (32+ символа). Сгенерировать: openssl rand -base64 48
SESSION_SECRET="change-me"

# ─── Оплата ─────────────────────────────────────────────────────
# mock — тестовый провайдер (реальные деньги не списываются).
# halyk | kaspi | freedom — заготовки; работают только после реализации интеграции и договора.
PAYMENT_PROVIDER="mock"
# Разрешить тестовые платежи на production-сборке (только для демо-стенда!)
ALLOW_TEST_PAYMENTS="false"
# Секрет подписи уведомлений тестового провайдера (по умолчанию — SESSION_SECRET)
MOCK_PAYMENT_SECRET=""

# ─── Отображение ────────────────────────────────────────────────
# Плашка «Демонстрационная версия» внизу сайта. false — скрыть (когда данные реальные)
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Демо-данные ────────────────────────────────────────────────
# Пароль демо-пользователей при выполнении npm run db:seed (НЕ используйте сид на боевой базе)
SEED_PASSWORD=""

# ─── Тесты ──────────────────────────────────────────────────────
# Отдельная база для автотестов (имя обязательно должно содержать "test")
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/basmart_test?schema=public"
